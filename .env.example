# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file — it is gitignored.

# ── WhatsApp Bot ───────────────────────────────────────────────────────────────
# Your WhatsApp number (digits only, no + or spaces)
OWNER_NUMBER=1234567890

# Display name shown in bot messages
BOT_NAME=WhatsBot

# ── Telegram Bot (optional — for remote QR scanning) ──────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Server ─────────────────────────────────────────────────────────────────────
# Random secret for session signing (generate with: openssl rand -hex 32)
SESSION_SECRET=change_me_to_a_random_secret

# Port is set automatically by Replit — do not set it manually
# PORT=8080
